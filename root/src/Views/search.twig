{% extends "base.twig" %}

{% block title %}Suche - {% endblock %}

{% block mainContent %}
    {% if loggedIn %}
        <h1>Suche</h1>
        <p>Hier kannst du nach gewünschten Artikeln und Inhalten suchen.</p>
        <form id="search" class="search" method="post" action="/search/search">
            <label>
                <input type="search" name="search" placeholder="Wiki durchsuchen" required value="{{ query }}">
            </label>
            <label>
                <input type="submit" name="submit">
                <i class="fa-solid fa-magnifying-glass"></i>
            </label>
        </form>
        <label>
            <input form="search" class="button" type="submit" name="submit" value="Suchen">
        </label>
        {% if searched == true %}
            <div class="searchResults">
                {% if articles is empty %}
                    <p>Zu deiner Suchanfrage wurden keine Ergebnisse gefunden.</p>
                {% else %}
                    <ul>
                        {% for article in articles.__serialize %}
                            <li {% if article.empty %}class="emptyArticle"{% endif %}>
                                <a href="/article?id={{ article.id }}{% if matchedAliases is defined and matchedAliases[article.id] is defined %}&alias={{ matchedAliases[article.id]|url_encode }}{% endif %}" class="article">
                                    <div class="articleText">
                                        <h3>{{ article.headline }}</h3>
                                        <p>Erstellt am {{ article.published|date("d.m.Y - H:i:s") }} von {{ article.createdBy.username }}</p>
                                        {% if matchedAliases is defined and matchedAliases[article.id] is defined %}
                                            <p class="matchedAlias">gefunden über: {{ matchedAliases[article.id] }}</p>
                                        {% endif %}
                                    </div>
                                    {% if article.categories %}
                                        <span class="articleCategories">
                                            {% for category in article.categories.__serialize %}
                                                <span class="articleCategory">
                                                    {% if category.icon %}
                                                        <img src="{{ category.icon }}" alt="{{ category.name }}">
                                                    {% endif %}
                                                    {{ category.name }}
                                                </span>
                                            {% endfor %}
                                        </span>
                                    {% endif %}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        {% endif %}
    {% else %}
        {{ _self.notLoggedIn() }}
    {% endif %}
{% endblock %}