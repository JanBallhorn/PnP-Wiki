# Copy this file to .env (which is gitignored) and fill in real values.
# The values below are safe DEV defaults for the Docker setup; on the server
# use real secrets and your production domain.

# --- Database (must match the "db" service in docker-compose.yml) ---
DB_HOST=db
DB_USER=wiki
DB_PASSWORD=wiki
DB_NAME=wiki

# --- Public base URL of the site (must match the web port in docker-compose.yml) ---
BASE_URL=http://localhost:8090

# --- JWT signing key for login tokens (use a long random string!) ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Login cookie lifetimes in seconds (session vs. "remember me") ---
COOKIE_LIFETIME_DEFAULT=3600
COOKIE_LIFETIME_REMEMBER=2592000

# --- Cookie domain: leave EMPTY for localhost (host-only cookie); set your
#     domain in production. A literal "localhost" is rejected by browsers. ---
COOKIE_DOMAIN=
# --- Secure cookies: false for local plain-HTTP, true (or unset) in production over HTTPS ---
COOKIE_SECURE=false

# --- Comma-separated e-mail whitelist allowed to register ---
REGISTER_WHITELIST=you@example.com

# --- Sender address for outgoing mail ---
MAIL_FROM=noreply@localhost
